<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>a question for rosie 🎀</title>
<style>
  :root {
    --pink: #ffb6cf;
    --pink-dark: #ff8fb3;
    --purple: #ffc9dd;
    --bg1: #fff5f8;
    --bg2: #ffe3ee;
    --text: #7a3a52;
  }

  * { box-sizing: border-box; }

  html, body {
    height: 100%;
    margin: 0;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
  }

  body {
    min-height: 100%;
    background: linear-gradient(135deg, var(--bg1), var(--bg2));
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  .hearts-bg {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }

  .floating-heart {
    position: absolute;
    bottom: -50px;
    color: var(--pink);
    opacity: 0.35;
    animation: floatUp linear infinite;
    font-size: 24px;
  }

  @keyframes floatUp {
    0% { transform: translateY(0) rotate(0deg); opacity: 0; }
    10% { opacity: 0.35; }
    90% { opacity: 0.35; }
    100% { transform: translateY(-110vh) rotate(360deg); opacity: 0; }
  }

  .card {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(6px);
    border-radius: 28px;
    padding: 48px 36px;
    max-width: 460px;
    width: 90%;
    text-align: center;
    box-shadow: 0 20px 60px rgba(255, 143, 179, 0.25);
    border: 1px solid #ffe0eb;
    transition: transform 0.3s ease;
  }

  .emoji-row {
    font-size: 40px;
    margin-bottom: 10px;
    animation: pulse 1.8s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }

  h1 {
    color: var(--text);
    font-size: 1.7rem;
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .name-highlight {
    color: var(--pink-dark);
    font-weight: 800;
  }

  p.sub {
    color: #a15577;
    margin: 0 0 32px;
    font-size: 1rem;
  }

  .buttons {
    display: flex;
    gap: 20px;
    justify-content: center;
    align-items: center;
    position: relative;
    min-height: 70px;
  }

  button {
    border: none;
    border-radius: 50px;
    padding: 16px 32px;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    font-family: inherit;
  }

  #yesBtn {
    background: linear-gradient(135deg, var(--pink-dark), var(--pink));
    color: white;
    box-shadow: 0 8px 20px rgba(255, 143, 179, 0.45);
    transition: transform 0.2s ease, box-shadow 0.2s ease, font-size 0.2s ease, padding 0.2s ease;
  }

  #yesBtn:hover {
    transform: scale(1.08);
    box-shadow: 0 10px 26px rgba(255, 143, 179, 0.6);
  }

  #noBtn {
    background: #fff0f5;
    color: #d99cb3;
    border: 1px solid #ffd6e6;
    position: relative;
  }

  #noBtn:hover {
    background: #ffe6ef;
  }

  .result-screen {
    display: none;
  }

  .result-screen.show {
    display: block;
    animation: popIn 0.5s ease;
  }

  @keyframes popIn {
    0% { transform: scale(0.7); opacity: 0; }
    70% { transform: scale(1.05); }
    100% { transform: scale(1); opacity: 1; }
  }

  .question-screen.hide {
    display: none;
  }

  .big-emoji {
    font-size: 60px;
    margin-bottom: 12px;
  }

  .confetti {
    position: fixed;
    width: 10px;
    height: 10px;
    top: -20px;
    z-index: 5;
    border-radius: 2px;
    pointer-events: none;
    animation: confettiFall linear forwards;
  }

  @keyframes confettiFall {
    to {
      transform: translateY(110vh) rotate(720deg);
      opacity: 0.9;
    }
  }

  .no-count {
    margin-top: 14px;
    font-size: 0.85rem;
    color: #c98aa8;
    min-height: 18px;
    font-style: italic;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg1: #3a1530;
      --bg2: #2a1024;
      --text: #ffd6ea;
    }
    body:not([data-theme="light"]) .card {
      background: rgba(40, 15, 35, 0.85);
    }
    body:not([data-theme="light"]) p.sub {
      color: #e3a8c4;
    }
    body:not([data-theme="light"]) #noBtn {
      background: #4a3040;
      color: #ccc;
    }
  }
</style>
</head>
<body>

<div class="hearts-bg" id="heartsBg"></div>

<div class="card" id="card">

  <div class="question-screen" id="questionScreen">
    <div class="emoji-row">🎀💗🎀</div>
    <h1>hey <span class="name-highlight">rosie</span>...<br>may i be your bf?</h1>

    <div class="buttons">
      <button id="yesBtn" onclick="sayYes()">yes! 💕</button>
      <button id="noBtn" onmouseover="dodge()" ontouchstart="dodge(event)">no</button>
    </div>

    <div class="no-count" id="noCount"></div>
  </div>

  <div class="result-screen" id="resultScreen">
    <div class="big-emoji">🎉💖🎉</div>
    <h1 id="resultTitle">yay!!!</h1>
    <p class="sub" id="resultSub">awesome sauce!!! i hope you enjoy the stuff!!!</p>
  </div>

</div>

<script>
  // Floating hearts background
  const heartsBg = document.getElementById('heartsBg');
  const heartEmojis = ['💗', '💕', '💖', '💓', '❤️'];
  for (let i = 0; i < 18; i++) {
    const h = document.createElement('div');
    h.className = 'floating-heart';
    h.textContent = heartEmojis[Math.floor(Math.random() * heartEmojis.length)];
    h.style.left = Math.random() * 100 + '%';
    h.style.fontSize = (16 + Math.random() * 20) + 'px';
    h.style.animationDuration = (8 + Math.random() * 10) + 's';
    h.style.animationDelay = (Math.random() * 10) + 's';
    heartsBg.appendChild(h);
  }

  // Dodging "No" button
  const noBtn = document.getElementById('noBtn');
  const yesBtn = document.getElementById('yesBtn');
  const card = document.getElementById('card');
  const noCount = document.getElementById('noCount');

  const dodgeMessages = [
    "nice try 😏",
    "nope, try again!",
    "not happening 😌",
    "catch me if you can!",
    "the 'no' button is shy 🙈",
    "come on... you know you want to click yes",
    "this button has commitment issues (unlike me)",
    "it's getting tired of running 😂"
  ];
  let dodgeCount = 0;
  let yesScale = 1;

  function dodge(e) {
    if (e) e.preventDefault();
    dodgeCount++;

    const cardRect = card.getBoundingClientRect();
    const btnRect = noBtn.getBoundingClientRect();

    const maxX = cardRect.width - btnRect.width - 20;
    const maxY = cardRect.height - btnRect.height - 20;

    const newX = Math.max(10, Math.random() * maxX);
    const newY = Math.max(10, Math.random() * maxY);

    noBtn.style.position = 'absolute';
    noBtn.style.left = newX + 'px';
    noBtn.style.top = newY + 'px';

    // grow the Yes button a little each time, capped
    if (yesScale < 1.6) {
      yesScale += 0.06;
      yesBtn.style.transform = `scale(${yesScale})`;
    }

    noCount.textContent = dodgeMessages[Math.min(dodgeCount - 1, dodgeMessages.length - 1)];
  }

  function sayYes() {
    document.getElementById('questionScreen').classList.add('hide');
    const result = document.getElementById('resultScreen');
    result.classList.add('show');
    launchConfetti();
  }

  function launchConfetti() {
    const colors = ['#ff6fa5', '#e84c8a', '#b06ab3', '#ffd1e3', '#ffffff', '#ffb6c9'];
    for (let i = 0; i < 80; i++) {
      setTimeout(() => {
        const conf = document.createElement('div');
        conf.className = 'confetti';
        conf.style.left = Math.random() * 100 + 'vw';
        conf.style.background = colors[Math.floor(Math.random() * colors.length)];
        conf.style.width = conf.style.height = (6 + Math.random() * 8) + 'px';
        conf.style.animationDuration = (2.5 + Math.random() * 2) + 's';
        document.body.appendChild(conf);
        setTimeout(() => conf.remove(), 5000);
      }, i * 30);
    }
  }
</script>

</body>
</html>
